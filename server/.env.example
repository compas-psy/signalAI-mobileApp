# Шаблон окружения. НАСТОЯЩИЙ .env создаётся на сервере bootstrap-скриптом
# с правами 0600 и в git не попадает никогда (§21).

POSTGRES_USER=signalai
POSTGRES_PASSWORD=          # сгенерировать на сервере, не придумывать руками
POSTGRES_DB=signalai

# Device pairing: bootstrap alone never mints a bearer. Provision a new random
# session for a bounded pairing window; do not commit a real value here.
SIGNALAI_DEVICE_TOKEN=
SIGNALAI_DEVICE_PAIRING_SESSION_ID=
SIGNALAI_DEVICE_PAIRING_EXPIRES_AT=
SIGNALAI_DEVICE_PAIRING_MAX_USES=1

# Heavy research lane. Dataset bytes live on the durable compose volume;
# DatasetSnapshot rows in PostgreSQL are immutable manifests for these files.
SIGNALAI_DATASET_SNAPSHOT_ROOT=/var/lib/signalai-datasets
SIGNALAI_BYBIT_RESEARCH_EVERY_MINUTES=60
SIGNALAI_RISK_OPTIMIZER_WAKEUP_MINUTES=1440

# Ключи брокеров. Вводятся на сервере, не хранятся в репозитории и не
# логируются. Право на вывод средств не выдаётся никогда (§19.3).
BYBIT_READ_KEY=
BYBIT_READ_SECRET=
BYBIT_EXEC_KEY=
BYBIT_EXEC_SECRET=
TINVEST_INVEST_READ_TOKEN=
TINVEST_TRADE_READ_TOKEN=
TINVEST_TRADE_EXEC_TOKEN=
TINVEST_SANDBOX_TOKEN=
