<?xml version="1.0" encoding="utf-8"?>
<!-- Автобэкап Android (до API 30): журнал сделок и настройки переживают
     переустановку через резервную копию Google. Включён только каталог
     signalai/ — при явных include всё остальное не копируется вовсе, поэтому
     торговые секреты в копию не попадают: их зашифрованные обёртки лежат в
     SharedPreferences, а ключ шифрования — в Keystore, который не бэкапится
     по построению. -->
<full-backup-content>
    <include domain="file" path="signalai/"/>
</full-backup-content>
