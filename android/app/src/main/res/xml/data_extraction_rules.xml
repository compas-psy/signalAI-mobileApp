<?xml version="1.0" encoding="utf-8"?>
<!-- То же для API 31+: облачная копия и перенос на новое устройство.
     Только каталог signalai/ — секреты остаются за бортом по построению. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="signalai/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="signalai/"/>
    </device-transfer>
</data-extraction-rules>
